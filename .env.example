# Neon Postgres — use the pooled connection string (the "-pooler" host) so
# serverless/multi-instance deploys don't exhaust max_connections.
DATABASE_URL="postgresql://user:password@ep-example-12345-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Secret used to sign the admin session JWT (lib/auth.ts / proxy.ts).
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# The FIRST admin account, created by scripts/seed.ts. Both are optional: with neither set,
# the seed uses admin@example.com and generates a random password that it prints ONCE.
# There is deliberately no default password — a fixed one in a public repo is a working
# login to the account that can edit prices, read customer addresses and delete orders.
# Only ever used to create the account; re-running the seed never touches an existing one.
SEED_ADMIN_EMAIL="you@yourdomain.com"
SEED_ADMIN_PASSWORD=""

# Secret used to sign the customer session JWT (lib/customer-auth.ts / proxy.ts).
# Separate from ADMIN_SESSION_SECRET so compromising one doesn't compromise the other.
# Generate one with: openssl rand -base64 32
# Rotating this invalidates every existing customer session cookie.
CUSTOMER_SESSION_SECRET="replace-with-a-long-random-string"

# Transactional email (lib/email/index.ts). Leave EMAIL_PROVIDER unset (or "dev") to
# keep emails logged to the EmailLog table only — nothing is actually sent, safe for
# local dev. Set to "resend" + the two vars below to send for real via resend.com.
EMAIL_PROVIDER="dev"
RESEND_API_KEY="replace-with-your-resend-api-key"
EMAIL_FROM="ALEXANDRIS <orders@yourdomain.com>"

# Courier integration (lib/courier/index.ts). Leave unset (or "manual") to have the
# admin type in a tracking number by hand — no live API calls are made. Set to "acs"
# + the ACS_* credentials below only once you've verified them against your real ACS
# Courier account; this app never calls the live ACS API during development/testing.
COURIER_PROVIDER="manual"
ACS_API_KEY="replace-with-your-acs-api-key"
ACS_COMPANY_ID="replace-with-your-acs-company-id"
ACS_COMPANY_PASSWORD="replace-with-your-acs-company-password"
ACS_USER_ID="replace-with-your-acs-user-id"
ACS_USER_PASSWORD="replace-with-your-acs-user-password"
ACS_BILLING_CODE="replace-with-your-acs-billing-code"

# Optional — where the Contact page's notification email goes. Falls back to
# settings.contactEmail (Site Settings in the admin) if unset.
CONTACT_EMAIL="hello@yourdomain.com"

# Google OAuth customer login (lib/oauth/providers/google.ts). Create credentials at
# https://console.cloud.google.com/apis/credentials — Web application type, with
# https://yourdomain.com/api/auth/oauth/google/callback as an authorized redirect URI.
# Leave either var unset to hide the Google button (degrades gracefully, no error).
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"

# Facebook Login customer login (lib/oauth/providers/facebook.ts). Create an app at
# https://developers.facebook.com/apps, add the Facebook Login product, and register
# https://yourdomain.com/api/auth/oauth/facebook/callback as a valid OAuth redirect URI.
# Leave either var unset to hide the Facebook button.
FACEBOOK_CLIENT_ID="replace-with-your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="replace-with-your-facebook-app-secret"

# Sign in with Apple customer login (lib/oauth/providers/apple.ts). Requires a paid
# Apple Developer Program membership ($99/yr): register a Services ID (APPLE_CLIENT_ID,
# distinct from an App ID), enable Sign in with Apple on it with
# https://yourdomain.com/api/auth/oauth/apple/callback as the return URL, verify the
# yourdomain.com domain, then generate a Sign in with Apple private key (.p8, downloadable
# only once) for APPLE_KEY_ID/APPLE_PRIVATE_KEY. Paste the .p8 file's contents as-is
# (PEM format) — literal `\n` line breaks are fine, they're normalized before use.
# Leave any var unset to hide the Apple button. Cannot be tested over plain
# http://localhost — Apple requires a verified https domain for the return URL.
APPLE_TEAM_ID="replace-with-your-apple-team-id"
APPLE_CLIENT_ID="replace-with-your-apple-services-id"
APPLE_KEY_ID="replace-with-your-sign-in-with-apple-key-id"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-p8-key-contents\n-----END PRIVATE KEY-----"

# Secures GET /api/cron/email-followups — Vercel automatically sends this as
# `Authorization: Bearer <value>` to the path configured in vercel.json.
# Generate one with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"

# Absolute site URL used to build links in emails sent from contexts with no `request`
# object (the back-in-stock notification, the daily email-followups cron job). Falls
# back to the Vercel-provided deployment URL, then localhost, if unset.
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Vercel Blob (lib/blob.ts) — image storage for the Media Library's upload button and
# the admin CSV bulk-import tool's product images. Connect a Blob store to this project
# from the Vercel dashboard's Storage tab (same flow as the Neon Postgres integration) —
# it provisions this token automatically in Production/Preview. For local dev, copy the
# generated token here. Leave unset to disable real uploads locally (a clear
# "not configured" error surfaces instead of a silent failure).
BLOB_READ_WRITE_TOKEN="replace-with-your-vercel-blob-read-write-token"

# ---------------------------------------------------------------------------
# Payments (lib/payments/, services/payments.ts â€” see PAYMENTS.md)
# ---------------------------------------------------------------------------

# REQUIRED before any external payment provider can be configured from the admin.
# Payment credentials are AES-256-GCM encrypted at rest with a key derived from this
# value (lib/payments/crypto.ts). Without it, Cash on Delivery and Bank Transfer still
# work (they store no secrets) but saving a Stripe/Piraeus/IRIS credential will fail
# with a clear error rather than storing it in plaintext.
# Generate one with: openssl rand -base64 32
# Rotating it makes every ALREADY-STORED provider secret undecryptable â€” you will need
# to re-enter them. Nothing else breaks.
PAYMENTS_CONFIG_SECRET="replace-with-a-long-random-string"

# Every payment provider can ALSO be configured entirely through environment
# variables instead of the admin UI, which is the right choice for production: the
# live credentials then live only in your hosting platform's secret store.
#
# The naming rule is mechanical â€” <PROVIDER_ID>_<FIELD_KEY>, upper-snake-cased:
#   provider "stripe"  + field "liveSecretKey" -> STRIPE_LIVE_SECRET_KEY
#   provider "piraeus" + field "merchantId"    -> PIRAEUS_MERCHANT_ID
# Plus two special keys per provider: _ENABLED and _ENVIRONMENT.
#
# An environment variable ALWAYS wins over a value saved in the admin, and the admin
# shows such a field as read-only rather than pretending a write took effect.

# --- Cash on Delivery (provider id: cash-on-delivery) ----------------------
# Works with no external account at all. Enabled by default on a fresh install.
# Its fee, order-value limits, countries and delivery-method restrictions are set in
# /admin/settings/payments/cash-on-delivery, not here.
CASH_ON_DELIVERY_ENABLED="true"

# --- Direct Bank Transfer (provider id: bank-transfer) ---------------------
# Also works with no external account. The bank details below are shown to the
# customer at checkout and in their confirmation email; none of them are secrets.
# Easiest to fill in from /admin/settings/payments/bank-transfer instead.
BANK_TRANSFER_ENABLED="true"
BANK_TRANSFER_BANK_NAME=""
BANK_TRANSFER_ACCOUNT_HOLDER=""
BANK_TRANSFER_IBAN=""
BANK_TRANSFER_SWIFT=""

# --- Stripe (provider id: stripe) ------------------------------------------
# Cards and wallets via Stripe's HOSTED checkout â€” no card data ever reaches this
# application. Create keys at https://dashboard.stripe.com/apikeys and a webhook
# endpoint pointing at https://yourdomain.com/api/payments/webhooks/stripe
# (events: checkout.session.completed, checkout.session.expired,
#  payment_intent.succeeded, payment_intent.payment_failed, charge.refunded).
# STRIPE_ENVIRONMENT decides which pair below is used: "sandbox" or "production".
# Without the matching webhook secret, incoming webhooks are stored but never applied.
STRIPE_ENABLED="false"
STRIPE_ENVIRONMENT="sandbox"
STRIPE_TEST_SECRET_KEY=""
STRIPE_TEST_WEBHOOK_SECRET=""
STRIPE_LIVE_SECRET_KEY=""
STRIPE_LIVE_WEBHOOK_SECRET=""

# --- Apple Pay (provider id: apple-pay) ------------------------------------
# Not an acquirer â€” a way of presenting a card that a processor then charges.
# With Stripe's hosted checkout, Stripe presents the Apple Pay sheet on its own
# verified domain, so no merchant identifier or domain file is needed here. Those
# fields exist for a future on-site (Elements / Payment Request) integration.
APPLE_PAY_ENABLED="false"
APPLE_PAY_PROCESSING_PROVIDER="stripe"

# --- IRIS (provider id: iris) ----------------------------------------------
# Integration BOUNDARY only. The provider, its configuration screen, its webhook
# endpoint and its place in the payment interface all exist, but payment creation
# refuses rather than guessing an undocumented API. Supply your acquirer's IRIS
# e-commerce integration guide to complete it. It can never appear at checkout in
# this state, whatever these values are set to.
IRIS_ENABLED="false"
IRIS_ENVIRONMENT="sandbox"

# --- Piraeus Bank (provider id: piraeus) -----------------------------------
# Integration BOUNDARY only, same as IRIS. The field set below is provisional and
# must be reconciled with the bank's own integration documentation â€” this app does
# not invent bank API parameters.
PIRAEUS_ENABLED="false"
PIRAEUS_ENVIRONMENT="sandbox"
PIRAEUS_MERCHANT_ID=""
PIRAEUS_TERMINAL_ID=""
PIRAEUS_API_KEY=""
PIRAEUS_API_SECRET=""
PIRAEUS_CLIENT_ID=""
PIRAEUS_CLIENT_SECRET=""
PIRAEUS_WEBHOOK_SECRET=""
