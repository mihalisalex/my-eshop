// Prisma 7 schema. The datasource URL lives in prisma.config.ts (via env()),
// not here — that's the v7 convention, not an oversight.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The storefront is single-currency today (EUR is hardcoded throughout
// lib/commerce/providers/mock/cart.service.ts) — Product.currencyCode is the
// one source of truth price/compareAtPrice/salePrice share.
model Product {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  description   String
  /// Greek translation — optional, falls back to `name`/`description` (English) when absent. See lib/localize.ts.
  nameEl        String?
  descriptionEl String?

  priceAmount          Decimal  @db.Decimal(10, 2)
  compareAtPriceAmount Decimal? @db.Decimal(10, 2)
  salePriceAmount      Decimal? @db.Decimal(10, 2)
  /// What the item costs the business — the basis for margin. Optional because it's
  /// commercially sensitive and often unknown at import time; margin is computed on read
  /// (lib/product.ts), never stored, so it can't drift from price/cost.
  costPriceAmount      Decimal? @db.Decimal(10, 2)
  currencyCode         String   @default("EUR")

  /// Image[] — order matters (images[0] = card image, images[1] = hover-swap). Zod-validated on read/write.
  images Json
  /// ProductVideo[] | null. Zod-validated on read/write.
  videos Json?

  categoryId String
  /// onDelete: Restrict — a category with products assigned can't be deleted at the DB
  /// level even if the admin-side guard (app/admin/(dashboard)/categories/actions.ts)
  /// is ever bypassed; the admin flow is "reassign or delete the products first."
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags       String[]
  gender     String
  season     String?

  materials        String[]
  careInstructions String[]

  /// Explicit cross-sell override; falls back to same-category products when empty.
  relatedProductIds String[] @default([])

  isNew           Boolean @default(false)
  isSale          Boolean @default(false)
  isPreorder      Boolean @default(false)
  isBackorder     Boolean @default(false)
  fulfillmentNote String?

  rating      Float?
  reviewCount Int?

  sku     String  @unique
  barcode String?

  /// "deny" | "continue" — mirrors the Shopify-style convention used across the app.
  inventoryPolicy     String  @default("deny")
  shippingWeightGrams Int?
  /// Purchasability, NOT publication — whether a published product can currently be bought.
  /// Deliberately separate from `status`: a live product can be temporarily unbuyable
  /// (supplier issue) without being unpublished, and the admin list previously conflated
  /// the two by labelling this "Active"/"Draft".
  availableForSale    Boolean @default(true)

  /// Publication lifecycle: "draft" | "active" | "archived". Only "active" products are
  /// ever visible to customers (see services/products.ts — storefront reads filter on this
  /// by default and admin must explicitly opt out). Archived is a soft delete: it retires a
  /// product from the storefront while keeping it resolvable for the orders, carts and
  /// wishlists that already reference it, which a hard delete would break.
  status     String    @default("active")
  archivedAt DateTime?

  /// Merchandising/sourcing attributes. Free text rather than relations — these are
  /// filter/report dimensions today, not entities with their own pages or behaviour;
  /// promoting them to tables is a later step if they ever need one.
  brand  String?
  vendor String?

  /// ProductSeoOverride | null. Zod-validated on read/write.
  seo Json?

  colors              ProductColor[]
  sizes               ProductSize[]
  reviews             ProductReview[]
  slugHistory         ProductSlugHistory[]
  collections         ProductCollection[]
  cartLineItems       CartLineItem[]
  wishlistItems       WishlistItem[]
  backInStockRequests BackInStockRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The storefront's hottest read path: every PLP (/women, /men, /collections/[slug],
  /// category pages) filters on gender and/or category. Those filters are applied in the
  /// query itself rather than in JS, so without these the listing pages sequential-scan
  /// the whole catalog on every request. [gender, categoryId] also serves gender-only
  /// lookups via its leftmost prefix, so no separate single-column gender index is needed.
  /// isNew/isSale are deliberately left unindexed — booleans that split the catalog
  /// roughly in half aren't selective enough for an index to beat a scan.
  @@index([gender, categoryId])
  @@index([categoryId])
  @@map("products")
}

/// Real taxonomy, replacing the flat string that used to live on Product.category —
/// supports unlimited nesting (self-relation), admin-managed images/SEO, and stable
/// display order. See services/categories.ts and app/admin/(dashboard)/categories/.
model Category {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  /// Greek translation — optional, falls back to `name` when absent. See lib/localize.ts.
  nameEl        String?
  description   String?
  descriptionEl String?

  parentId String?
  /// onDelete: SetNull — deleting a parent promotes its children to top-level rather than
  /// cascading the delete, which would silently destroy an entire subtree. The admin delete
  /// action additionally blocks deleting a category that still has children or assigned
  /// products, so SetNull is a safety net for direct DB operations, not the normal path.
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  /// Stable display order among siblings — same convention as ProductColor.position.
  /// Drag-and-drop reordering in the admin only ever reorders within one parent; moving a
  /// category to a different parent is a deliberate field edit (parentId), not a cross-tree
  /// drag, so position never needs to be unique/compacted across the whole table.
  position Int @default(0)

  /// Image | null — card image for nav menus / category grids. Zod-validated on read/write.
  image       Json?
  /// Image | null — wide banner shown on the category's own storefront page.
  bannerImage Json?

  isFeatured Boolean @default(false)
  isVisible  Boolean @default(true)

  /// ProductSeoOverride | null — same shape/convention as Product.seo.
  seo Json?

  products    Product[]
  slugHistory CategorySlugHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

/// Every slug a category has ever had. Renaming used to 404 the old URL outright, losing
/// the accumulated SEO equity and breaking every inbound link — a real revenue cost for a
/// storefront, and the most likely thing an admin does after launch.
///
/// Points at the category rather than storing a from/to pair, which means rename chains
/// (a -> b -> c) resolve in one hop to whatever the CURRENT slug is, with no chain-walking
/// and no stale intermediate redirects.
model CategorySlugHistory {
  id String @id @default(cuid())

  /// Unique across all history: two categories can't both claim the same old slug, and it
  /// makes the lookup a single indexed read.
  slug       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([categoryId])
  @@map("category_slug_history")
}

/// Every slug a product has ever had — the exact counterpart of CategorySlugHistory, and
/// added for the same reason one page later: a product page is the single most linked-to
/// and most ranked URL a shop has, and the slug is freely editable in the admin form.
/// Renaming one used to 404 it outright, losing whatever ranking it had accumulated along
/// with every inbound link, every share and every printed reference to it.
///
/// Points at the product rather than storing a from/to pair, so a rename chain
/// (a -> b -> c) resolves in one hop to the CURRENT slug with no chain-walking and no
/// stale intermediate redirects.
model ProductSlugHistory {
  id String @id @default(cuid())

  /// Unique across all history: two products can't both claim the same retired slug, and
  /// it makes the redirect lookup a single indexed read.
  slug      String  @unique
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_slug_history")
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Stable display order — Postgres doesn't guarantee row order, so reads always `orderBy: { position: "asc" }`.
  position Int
  name     String
  hex      String
  imageSrc String?
  imageAlt String?

  @@index([productId])
  @@map("product_colors")
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Stable display order — see ProductColor.position.
  position Int
  name     String
  inStock  Boolean @default(true)
  /// Guarded in the database by a CHECK (quantity >= 0) constraint, added in the
  /// 20260831090000 migration. Prisma has no schema syntax for CHECK constraints, so it
  /// lives in the migration SQL only and will not appear here — do not "restore" it by
  /// removing the constraint when Prisma reports no drift for it.
  ///
  /// It is a backstop, not the mechanism: the real guarantee is that every decrement is a
  /// conditional UPDATE (services/checkout.ts) and every admin write is a delta
  /// (lib/products-import/write.ts). The constraint is what turns the next bug in either
  /// of those from silent negative stock into a loud failure.
  quantity Int     @default(0)
  sku      String?
  barcode  String?

  @@index([productId])
  @@map("product_sizes")
}

model Collection {
  id            String  @id @default(cuid())
  slug          String  @unique
  title         String
  subtitle      String?
  description   String?
  /// Greek translations — optional, fall back to English when absent. See lib/localize.ts.
  titleEl       String?
  subtitleEl    String?
  descriptionEl String?

  /// Image. Zod-validated on read/write.
  image Json

  ctaLabel   String?
  ctaHref    String?
  ctaVariant String?

  /// CategorySeoOverride | null — same shape and convention as Category.seo, because a
  /// collection is the same kind of thing to a search engine: a curated landing page that
  /// wants its own title, description and editorial intro. It was the one such entity with
  /// no way to set any of them.
  seo Json?

  products ProductCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collections")
}

/// Real many-to-many join table — replaces the JSON model's two independently
/// maintained arrays (Product.collectionIds / Collection.productIds) so a
/// delete on either side can't leave a dangling reference on the other.
model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

model AdminUser {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  /// Sessions issued before this moment are rejected (AUTH-001). Set on every password
  /// change or reset: a stateless JWT cannot be revoked, so without this an attacker
  /// who had signed in kept a working session for the rest of its lifetime even after
  /// the victim changed the password to lock them out. Compared against the token own
  /// `iat` claim in the session DAL. Null means "never invalidated".
  sessionsValidFrom DateTime?

  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Real Backend Phase 2 — Customer accounts, Cart, Wishlist, Checkout, Orders
// ---------------------------------------------------------------------------

model Customer {
  id                String    @id @default(cuid())
  email             String    @unique
  /// Null for an OAuth-only account (Google/Apple/Facebook, no password ever set).
  /// See lib/oauth/ and CustomerOAuthAccount below.
  passwordHash      String?
  /// Sessions issued before this moment are rejected (AUTH-001). Set on every password
  /// change or reset: a stateless JWT cannot be revoked, so without this an attacker
  /// who had signed in kept a working session for the rest of its lifetime even after
  /// the victim changed the password to lock them out. Compared against the token own
  /// `iat` claim in the session DAL. Null means "never invalidated".
  sessionsValidFrom DateTime?

  firstName        String
  lastName         String
  phone            String?
  acceptsMarketing Boolean @default(false)

  /// Points at a CustomerAddress.id. Plain column, not a formal FK, to avoid a
  /// circular two-way relation with CustomerAddress.customerId. App-level
  /// integrity: removeCustomerAddress() clears this if it points at the
  /// address being deleted.
  defaultAddressId String?

  /// Lazily generated on first visit to the Referrals section of /account (see
  /// lib/referral.ts) — not every customer needs one, so it isn't generated at signup.
  referralCode String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses           CustomerAddress[]
  carts               Cart[]
  wishlist            Wishlist?
  orders              Order[]
  returns             Return[]
  passwordResetTokens PasswordResetToken[]
  conciergeRequests   ConciergeRequest[]
  referralsMade       Referral[]             @relation("ReferralsMade")
  referralReceived    Referral?              @relation("ReferralReceived")
  oauthAccounts       CustomerOAuthAccount[]
  backInStockRequests BackInStockRequest[]

  @@map("customers")
}

/// A linked Google/Apple/Facebook identity for a Customer. One customer can
/// link multiple providers; one provider identity belongs to exactly one
/// customer (enforced by the unique constraint below). See lib/oauth/.
model CustomerOAuthAccount {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// "google" | "apple" | "facebook"
  provider       String
  /// The provider's stable subject identifier (Google/Apple `sub`, Facebook `id`) — never the email, which can change.
  providerUserId String

  /// Captured once at link time as a display fallback only — Customer.firstName/lastName
  /// remain the source of truth everywhere else. Notably, Apple only ever sends
  /// name/email on the FIRST authorization for a given account; this is where it's
  /// preserved for that account, not re-fetched on later logins.
  email String?

  createdAt DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([customerId])
  @@map("customer_oauth_accounts")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Stable display order — see ProductColor.position.
  position    Int
  firstName   String
  lastName    String
  company     String?
  address1    String
  address2    String?
  city        String
  region      String?
  postalCode  String
  countryCode String
  phone       String?

  @@index([customerId])
  @@map("customer_addresses")
}

model Cart {
  id           String    @id @default(cuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currencyCode String    @default("EUR")

  lineItems CartLineItem[]
  discounts CartDiscount[]
  giftCards CartGiftCard[]
  /// One-to-many, not one-to-one: the cart row is reused indefinitely after an order
  /// completes (see the cart DELETE route), so a cart can accumulate multiple checkout
  /// sessions over its lifetime — one per purchase. `services/checkout.ts`'s
  /// `createCheckout` finds the latest non-completed row or opens a fresh one.
  checkouts Checkout[]

  /// Set once an abandoned-cart recovery email has been sent for the CURRENT idle
  /// episode — but also doubles as the "may I send again" gate: eligible again once
  /// any CartLineItem.addedAt is newer than this (see services/email-followups.ts),
  /// since the Cart row itself is reused indefinitely and never reflects a plain
  /// "already emailed, never again" boolean would be wrong after the customer returns.
  abandonedCartEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("carts")
}

/// Totals (subtotal/tax/shipping/total) are NEVER persisted — always recomputed
/// from lineItems+discounts+giftCards at read time (lib/commerce/postgres/cart-totals.ts),
/// exactly like the mock's computeTotals(). This avoids any stored/derived drift.
model CartLineItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  slug            String
  name            String
  imageSrc        String
  imageAlt        String
  color           String
  size            String
  unitPriceAmount Decimal  @db.Decimal(10, 2)
  quantity        Int
  /// Snapshotted stock ceiling at add-time (see lib/product.ts's isSizePurchasable /
  /// the mock's buildLineItem) — re-validated for real at checkout, not just here.
  maxQuantity     Int
  savedForLater   Boolean  @default(false)
  addedAt         DateTime @default(now())

  @@index([cartId])
  @@index([productId])
  @@map("cart_line_items")
}

model CartDiscount {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  code      String
  /// "percentage" | "fixed"
  type      String
  value     Decimal  @db.Decimal(10, 2)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@unique([cartId, code])
  @@map("cart_discounts")
}

model CartGiftCard {
  id            String   @id @default(cuid())
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  code          String
  /// Snapshot of the GiftCard's balance at apply-time (display only) — the live
  /// balance lives on GiftCard.balanceAmount and is decremented at checkout.
  balanceAmount Decimal  @db.Decimal(10, 2)
  amountApplied Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  @@unique([cartId, code])
  @@map("cart_gift_cards")
}

model Checkout {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  email  String?
  /// "open" | "awaiting_payment" | "completed"
  status String  @default("open")

  /// Address | null — Zod-validated on read/write, reuses lib/validation/checkout.ts's addressSchema.
  shippingAddress Json?
  /// Address | null — Zod-validated, same schema.
  billingAddress  Json?
  /// ShippingRate | null — Zod-validated (lib/validation/commerce.ts).
  shippingRate    Json?

  giftWrap    Boolean @default(false)
  giftMessage String?

  /// The payment method the shopper selected, e.g. "cod" | "stripe_card".
  /// Nullable: it isn't chosen until the payment step, and an abandoned checkout
  /// never gets one. Availability is re-validated server-side at order time —
  /// a stored id here is a preference, never an authorisation.
  paymentMethodId String?

  createdAt DateTime @default(now())

  @@index([cartId])
  @@map("checkouts")
}

model Order {
  id            String    @id @default(cuid())
  checkoutId    String    @unique
  /// Nullable to support guest checkout.
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail String

  /// CartLineItem[] snapshot at purchase time — Zod-validated on read/write.
  lineItems       Json
  /// CartTotals snapshot at purchase time — Zod-validated.
  totals          Json
  /// Address — Zod-validated.
  shippingAddress Json
  /// Address — Zod-validated.
  billingAddress  Json
  /// ShippingRate — Zod-validated.
  shippingRate    Json

  giftWrap    Boolean @default(false)
  giftMessage String?

  /// "confirmed" | "processing" | "shipped" | "delivered" | "cancelled" | "refunded"
  /// Starts at "confirmed" — EXACT parity with the mock's completeCheckout, which sets
  /// status: "confirmed" immediately (verified by reading the actual mock source, not
  /// assumed) — no customer-facing regression. Admin fulfillment moves it forward from
  /// there (processing -> shipped -> delivered), with cancelled/refunded as terminal
  /// alternate states.
  status String @default("confirmed")

  /// Set by an admin (manual courier provider) or by lib/courier's ACS adapter
  /// (ACS_Create_Voucher) once a real shipment exists — see lib/courier/.
  trackingNumber String?
  /// Carrier display name, e.g. "ACS Courier". Independent of which CourierProvider
  /// created the shipment — a manually-entered ACS tracking number still says "ACS Courier".
  carrier        String?
  trackingUrl    String?

  /// Set exactly once, the moment status transitions to "delivered" (services/orders.ts's
  /// updateOrderStatus) — used to schedule the post-delivery review-request follow-up.
  /// No status-history table exists, so re-marking an already-delivered order as
  /// "delivered" again overwrites this — an accepted, disclosed edge case.
  deliveredAt         DateTime?
  /// Set once the review-request follow-up email has actually been sent for this order.
  reviewRequestSentAt DateTime?

  /// Set the moment the order-confirmation email actually goes out. Needed because
  /// that email is no longer always sent at checkout: for a redirect-based payment
  /// (card, wallet) it is sent when the payment is verified as settled, which can
  /// happen from either the return-path check or a webhook — whichever wins the
  /// race. This timestamp is what stops the loser sending a second copy.
  confirmationEmailSentAt DateTime?

  /// Set exactly once, the moment an order first moves to a stock-returning status
  /// (cancelled or refunded). Claimed with a null-guarded updateMany so two concurrent
  /// status changes cannot both credit the same units back - the same once-only pattern
  /// as confirmationEmailSentAt.
  restockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  returns  Return[]
  /// Normally exactly one, but a failed attempt the shopper retries with a
  /// different method legitimately adds a second — see the Payment model.
  payments Payment[]

  @@index([customerId])
  @@map("orders")
}

/// A customer's request to be emailed when a specific product size is back in stock.
/// Keyed on (productId, sizeName) rather than ProductSize.id, because
/// lib/products-import/write.ts's writeProductRow() deletes and recreates every
/// ProductSize row on every product edit — size ids churn constantly and can't be a
/// stable target. See lib/products-import/back-in-stock.ts for the detection/send logic.
model BackInStockRequest {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeName   String
  email      String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([productId, sizeName, email])
  @@index([productId, sizeName, notifiedAt])
  @@map("back_in_stock_requests")
}

/// A customer-initiated return request against one order. Items is a snapshot
/// (productId/name/color/size/quantity), not a live relation, matching Order.lineItems'
/// existing snapshot-Json convention — what was requested for return shouldn't change
/// if the underlying product is later edited or deleted.
model Return {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail String

  /// ReturnItem[] snapshot — Zod-validated on read/write.
  items  Json
  reason String

  /// "requested" | "approved" | "rejected" | "received" | "refunded"
  status String @default("requested")

  /// Set exactly once, the moment this return first reaches a status meaning the goods are
  /// physically back ("received", or "refunded" if the flow skipped straight past it).
  /// Claimed with a null-guarded updateMany, the same once-only pattern as
  /// Order.restockedAt — but a SEPARATE column, because a return covers a subset of the
  /// order's lines and the two paths can both fire on the same order. services/returns.ts
  /// and services/orders.ts each account for what the other has already credited.
  restockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@map("returns")
}

/// Owned by EITHER a signed-in customer (customerId) OR a guest capability
/// token (anonymousId) — never both. See app/api/wishlist's identity-resolution
/// rule for which one a given request actually uses.
model Wishlist {
  id          String    @id @default(cuid())
  customerId  String?   @unique
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  anonymousId String?   @unique
  /// Set the first time the owner clicks "Share" — a public, read-only view at /wishlist/shared/[shareToken]. Never regenerated once set, so a shared link keeps working.
  shareToken  String?   @unique

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

model Discount {
  id        String    @id @default(cuid())
  code      String    @unique
  /// "percentage" | "fixed"
  type      String
  value     Decimal   @db.Decimal(10, 2)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("discounts")
}

model GiftCard {
  id            String   @id @default(cuid())
  code          String   @unique
  /// Guarded in the database by a CHECK (balanceAmount >= 0) constraint, added in the
  /// 20260831180000 migration — the money counterpart of ProductSize.quantity's floor,
  /// and invisible to Prisma for the same reason. Do not "restore" it by removing the
  /// constraint when Prisma reports no drift for it.
  ///
  /// The real guarantee is the conditional decrement in services/checkout.ts, which
  /// redeems only a card that still holds the amount being taken. A card is one code that
  /// anyone holding it can spend, so two people redeeming it at once is an easier race to
  /// hit than two people racing for the last unit of stock.
  balanceAmount Decimal  @db.Decimal(10, 2)
  currencyCode  String   @default("EUR")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("gift_cards")
}

/// One row per attempt against a rate-limited endpoint — `lib/rate-limit.ts` counts
/// rows within a sliding window rather than maintaining a running counter, which
/// keeps the check race-free under concurrent requests with no locking needed.
/// `key` scopes the limit (e.g. "sign-in:{ip}", "sign-in:{email}", "sign-up:{ip}").
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_attempts")
}

/// Every email the app has ever "sent," through whichever `EmailProvider` was active
/// at the time (see lib/email/) — the dev provider writes here instead of calling a
/// real API, which makes "did the order-confirmation email actually fire" a real,
/// checkable question (admin Emails page) instead of something only console logs know.
model EmailLog {
  id       String   @id @default(cuid())
  to       String
  subject  String
  html     String
  text     String
  /// "order-confirmation" | "shipping-update" | "password-reset" | "return-status-update" | "welcome"
  template String
  sentAt   DateTime @default(now())

  @@index([to])
  @@index([sentAt])
  @@map("email_log")
}

/// One row per named CMS document — homepage sections, navigation, SEO defaults, site
/// settings. A generic key/Json store rather than one bespoke table per document: none
/// of these are queried by field (always read/written whole), and it lets every admin
/// CMS editor share one real persistence path instead of four near-identical tables.
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

model BlogPost {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  excerpt String
  content String?

  /// Image — Zod-validated on read/write, same convention as Product.images.
  coverImage Json

  author      String
  tags        String[]
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}

/// A real "Ask a Stylist" request (components/account/ or a public concierge form) —
/// same real-persistence treatment as ContactMessage, a separate table since it's a
/// distinct customer-facing feature with its own admin inbox and status workflow.
model ConciergeRequest {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name       String
  email      String
  topic      String
  message    String
  /// "open" | "responded" | "closed"
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([createdAt])
  @@map("concierge_requests")
}

/// One row per successful referral signup. `status` moves "pending" -> "rewarded"
/// when the referred customer's first order completes (services/checkout.ts) — the
/// reward is a real GiftCard row (this app's existing redeemable-by-code mechanism;
/// gift cards aren't customer-owned here, so "reward the referrer" means minting a
/// fresh code and emailing it to them, not crediting an account balance).
model Referral {
  id                 String    @id @default(cuid())
  referrerCustomerId String
  referrer           Customer  @relation("ReferralsMade", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  referredCustomerId String    @unique
  referred           Customer  @relation("ReferralReceived", fields: [referredCustomerId], references: [id], onDelete: Cascade)
  rewardGiftCardCode String?
  /// "pending" | "rewarded"
  status             String    @default("pending")
  createdAt          DateTime  @default(now())
  rewardedAt         DateTime?

  @@index([referrerCustomerId])
  @@map("referrals")
}

/// A real newsletter signup from the sitewide footer / homepage Newsletter section
/// (components/shared/NewsletterForm.tsx). Email is unique so re-subscribing is
/// idempotent rather than accumulating duplicate rows — the form shows the same
/// confirmation either way, which also avoids leaking whether an address is already
/// on the list.
model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Where the signup came from, e.g. "footer" | "homepage" — lets the admin list show
  /// which surface actually converts without a separate analytics dependency.
  source       String?
  subscribedAt DateTime @default(now())

  @@index([subscribedAt])
  @@map("newsletter_subscribers")
}

/// A real submission from the public Contact page (components/shared/ContactForm.tsx).
/// A real, first-class media asset. Before this table the Media Library was derived: it
/// listed images already referenced by a product/collection/homepage section, deduped by
/// URL. That meant an uploaded file was invisible until someone attached it to something,
/// there was nowhere to store alt text or organise anything, and nothing could be deleted
/// (the "library" was a read-only view of other tables).
model MediaAsset {
  id String @id @default(cuid())

  /// The public Blob URL. Unique because it's also how usage is detected — every consumer
  /// stores the URL, not a foreign key, so this is the join between an asset and its uses.
  url      String @unique
  /// The Blob object key. Kept alongside `url` because deletion targets the store, and a
  /// URL that has been rewritten (CDN, custom domain) can't always be mapped back to a key.
  pathname String
  filename String

  /// Default alt text, offered when the asset is attached somewhere. Consumers keep their
  /// own copy (Product.images[].alt etc.) since the right alt text is context-dependent.
  altText String?

  /// Flat label, not a tree — media folders are organisational, unlike Category, which is
  /// customer-facing taxonomy and genuinely needed nesting.
  folder String?
  tags   String[] @default([])

  contentType String?
  sizeBytes   Int?
  width       Int?
  height      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([createdAt])
  @@map("media_assets")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}

/// Short-lived, single-use token backing the password-reset flow. `tokenHash`, not
/// the raw token, is stored — same principle as password hashing: a DB read (or leak)
/// shouldn't hand out a usable credential. The raw token only ever exists in the
/// generated reset link and the requester's inbox (or, in dev, the EmailLog body).
model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Payments
//
// The payment domain is deliberately its OWN set of tables rather than columns
// bolted onto Order. An order's lifecycle and its money's lifecycle are separate
// facts (a Cash-on-Delivery order ships while its payment is still pending; a
// delivered order can later be refunded without the shipment un-happening), and
// collapsing them makes accounting impossible to reconstruct. See
// lib/payments/types.ts.
// ---------------------------------------------------------------------------

/// One attempt to collect the money for an order. An order normally has exactly
/// one, but a failed attempt that the shopper retries with a different method
/// legitimately produces a second row â€” hence a plain relation rather than a
/// unique. `idempotencyKey` is what stops a double-click or a retried request
/// from producing duplicates (Â§15).
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Registry id from lib/payments/registry.ts, e.g. "stripe" | "cod" | "piraeus".
  /// A plain string, not an enum, so a future provider needs no migration here.
  provider String
  /// Method id, e.g. "stripe_card" | "apple_pay" | "cod". One provider can serve
  /// several methods, which is why this is stored separately from `provider`.
  method   String

  /// The provider's own identifier (Stripe PaymentIntent id, bank reference, â€¦).
  /// Nullable because internal methods have none until/unless one is recorded.
  externalPaymentId String?

  amountAmount   Decimal @db.Decimal(10, 2)
  currencyCode   String  @default("EUR")
  /// Running total refunded. Kept as a column rather than derived from the
  /// transaction log so partial-refund arithmetic cannot drift from the audit trail.
  refundedAmount Decimal @default(0) @db.Decimal(10, 2)

  /// PaymentStatus â€” transitions are validated server-side by
  /// lib/payments/status.ts's assertTransition. Never written from client code.
  status String @default("pending")

  /// "sandbox" | "production" â€” recorded at creation time, so a payment taken in
  /// test mode stays identifiable after the store flips to live credentials.
  environment String @default("production")

  /// Stable per logical payment attempt. Unique so a retried create can be
  /// recognised and returned instead of duplicated.
  idempotencyKey String @unique

  failureReason String?
  /// Provider-specific extras (last4, redirect target, bank reference). Never
  /// credentials, never card numbers, never a CVV â€” see PAYMENTS.md, Security.
  metadata      Json    @default("{}")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?

  transactions PaymentTransaction[]
  webhooks     PaymentWebhookEvent[]

  @@index([orderId])
  @@index([status])
  @@index([provider, method])
  @@index([createdAt])
  @@index([externalPaymentId])
  @@map("payments")
}

/// Append-only audit trail. Every status change, webhook, manual confirmation and
/// provider error appends one row â€” this is what makes a real-world payment
/// dispute debuggable months later, and it is never updated or deleted.
model PaymentTransaction {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// PaymentEventType from lib/payments/types.ts.
  eventType String
  /// Status after this event, when the event changed one.
  status    String?
  /// "customer" | "admin" | "provider" | "system".
  actorType String  @default("system")
  /// AdminUser.id or Customer.id where known. Not a foreign key: an admin can be
  /// deleted long after the fact and the audit line must survive them.
  actorId   String?

  amountAmount Decimal? @db.Decimal(10, 2)
  currencyCode String?

  message String?
  /// Structured detail for the timeline. Provider payloads are redacted before
  /// they land here â€” the raw copy lives on PaymentWebhookEvent instead.
  data    Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
  @@index([eventType])
  @@map("payment_transactions")
}

/// Raw inbound webhook, stored before it is acted on. The (provider, eventId)
/// unique is the duplicate-suppression mechanism sections 14/15 require: a provider
/// that retries an event we already applied hits this constraint and the second
/// delivery becomes a no-op rather than a second refund.
model PaymentWebhookEvent {
  id        String @id @default(cuid())
  provider  String
  /// The provider's own event id. Providers that do not issue one get a hash of
  /// the payload, which achieves the same at-most-once effect for identical bodies.
  eventId   String
  eventType String

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// Verbatim body as received, kept for forensics. Signature verification runs
  /// against these exact bytes before anything is parsed.
  rawPayload String
  /// True only once a real signature check passed. An unverified event is stored
  /// (so an attack or a misconfiguration is visible) but never applied.
  verified   Boolean @default(false)

  /// "received" | "processed" | "ignored" | "failed"
  processingStatus String  @default("received")
  errorMessage     String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([provider, receivedAt])
  @@map("payment_webhook_events")
}

/// Credentials and environment for one provider. Secrets are AES-256-GCM encrypted
/// at rest (lib/payments/crypto.ts) and never leave the server in plaintext â€” the
/// admin UI receives a masked projection only. Non-secret values live in `config`
/// so they can be read and displayed without decryption.
model PaymentProviderConfig {
  id       String @id @default(cuid())
  /// Registry id â€” one row per provider.
  provider String @unique

  /// "sandbox" | "production".
  environment String  @default("sandbox")
  /// Master switch for the whole provider. Individual methods have their own
  /// toggle in PaymentMethodSetting; a disabled provider hides all of its methods.
  enabled     Boolean @default(false)

  /// Non-secret configuration values, keyed by PaymentConfigField.key.
  config           Json @default("{}")
  /// Secret values, each individually encrypted. Shape: { key: "v1.iv.tag.ciphertext" }.
  encryptedSecrets Json @default("{}")

  /// Result of the last "Test Connection" run, so the dashboard can show a real
  /// status without hitting every provider's API on each page load.
  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_provider_configs")
}

/// Admin-editable merchandising settings for one payment method. Capability facts
/// (supportsRefunds, requiresWebhook, â€¦) are NOT here â€” those are properties of the
/// integration and live in code beside the provider that implements them, where an
/// admin cannot toggle them into being true.
model PaymentMethodSetting {
  id       String @id @default(cuid())
  /// Method id from the provider's PaymentMethodDefinition, e.g. "cod".
  methodId String @unique
  provider String

  enabled   Boolean @default(false)
  sortOrder Int     @default(0)

  /// Overrides the definition's default customer-facing strings when set.
  displayName String?
  description String?

  /// "none" | "fixed" | "percentage". Always applied server-side (lib/payments/fees.ts).
  feeType  String  @default("none")
  feeValue Decimal @default(0) @db.Decimal(10, 2)

  minimumAmount Decimal? @db.Decimal(10, 2)
  maximumAmount Decimal? @db.Decimal(10, 2)

  /// ISO country codes. Empty array = available everywhere.
  countries       String[] @default([])
  /// lib/shipping.ts rate ids this method is restricted to. Empty = every rate.
  /// Exists for COD, which a store may want to forbid on express delivery.
  shippingRateIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@map("payment_method_settings")
}

/// A review written by a shopper, from the form on the product page.
///
/// Publication is decided at write time, not read time (see services/reviews.ts): a review
/// whose email matches a delivered order for this product is published immediately, and
/// everything else waits for an admin. Only APPROVED rows are ever read by the storefront.
model ProductReview {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 1-5. Guarded in the database by a CHECK constraint added in the migration, the same way
  /// ProductSize.quantity is — Prisma has no schema syntax for CHECK, so it lives in the
  /// migration SQL only and will not appear here. Do not "restore" it by dropping it.
  rating Int
  title  String
  body   String

  /// What the shopper is shown as. Never the email.
  authorName  String
  /// Kept private. Used once to decide verified status, then to recognise repeat abuse.
  authorEmail String

  /// True only where a delivered order for this exact product carries this email. Written
  /// once at submission and never recomputed, so a later refund cannot retroactively
  /// rewrite what a visitor already read.
  verifiedPurchase Boolean @default(false)

  status     ReviewStatus @default(pending)
  createdAt  DateTime     @default(now())
  /// When it became visible. Null while pending or rejected.
  approvedAt DateTime?

  /// The storefront reads (productId, status) and orders by date; the admin queue reads
  /// (status, createdAt) across all products.
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@map("product_reviews")
}

enum ReviewStatus {
  pending
  approved
  rejected
}

/// Who did what, in the admin (OBS-002).
///
/// Refunds, role changes, order edits and customer-PII access left no trace at all — for a
/// system where staff move money, "which of the four of us issued this refund" had no
/// answer. constants/permissions.ts already documented the intent: `admin:activity` was
/// removed with the seeded fake log it gated, "until the real AdminAuditLog".
///
/// Deliberately NOT a foreign key to AdminUser, and the actor's email is denormalised.
/// An audit trail that cascades away when the account is deleted is worse than none — the
/// single most interesting case is an admin who no longer works here, and a FK would erase
/// exactly that record at exactly the moment it starts to matter.
model AdminAuditLog {
  id String @id @default(cuid())

  /// The AdminUser id at the time. No relation on purpose — see above.
  actorId    String
  /// Copied at write time so the log stays readable after the account is gone.
  actorEmail String

  /// Dotted verb: "payment.refunded", "adminUser.role_changed", "order.status_changed".
  action     String
  targetType String
  targetId   String

  /// One line an operator can scan without decoding `metadata`.
  summary  String
  /// Before/after values where they matter. Never credentials, never card data.
  metadata Json?

  createdAt DateTime @default(now())

  /// The log is read newest-first overall, per-actor, and per-target ("everything that
  /// ever happened to this order") — one index each.
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_logs")
}
